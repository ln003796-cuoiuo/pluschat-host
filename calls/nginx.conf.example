server {
  server_name tell.плюсчат.рф;
  location /api/ { proxy_pass http://127.0.0.1:8081; proxy_set_header X-Forwarded-Proto https; proxy_set_header Host $host; }
  location /ws { proxy_pass http://127.0.0.1:8080; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "Upgrade"; }
}
