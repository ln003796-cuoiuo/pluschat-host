Options -Indexes
DirectoryIndex public/index.php

RewriteEngine On

# Feature PHP files are included by public/index.php and must not be called directly.
RewriteRule ^(?:admin|calls|channels|chats|files|groups|login|messages|notifications|profile|register|search|security|topics|users|tests|api/integrations)/.*\.php$ - [F,L,NC]

# Keep source, configuration and database files out of public access.
RewriteRule ^(?:bootstrap\.php|config(?:\.example)?\.php|database(?:/|$)|storage(?:/|$)|\.git(?:/|$)) - [F,L,NC]

# Expose the one-time installer at /setup.php while keeping it disabled after config.php exists.
RewriteRule ^setup\.php$ public/setup.php [QSA,L]

# Route API URLs to the single PHP entry point.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [QSA,L]

<FilesMatch "^(?:config(?:\.example)?\.php|bootstrap\.php|\.env|composer\.(?:json|lock))$">
    Require all denied
</FilesMatch>
